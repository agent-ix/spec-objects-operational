{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-operational/0.3.0/RunbookStep.json",
  "type": "object",
  "properties": {
    "name": {
      "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/Identifier.json"
    },
    "order": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "doc": {
      "type": "string"
    },
    "operation": {
      "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/Identifier.json"
    }
  },
  "required": [
    "name",
    "order",
    "doc"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "One ordered step of a runbook.\n\nReader rule JSON Schema cannot express (FR-004): `operation` names an\n`operations[].name` of the same record."
}
