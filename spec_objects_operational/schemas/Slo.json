{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-operational/0.3.0/Slo.json",
  "type": "object",
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/FieldDecl.json"
      },
      "minItems": 1,
      "contains": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-operational/0.3.0/MeasuredField.json"
      }
    },
    "clauses": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/ClauseRef.json"
      },
      "minItems": 1
    },
    "objective": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-operational/0.3.0/ObjectiveDecl.json"
    },
    "constrains": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/SemanticId.json"
      }
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/SemanticId.json"
      }
    }
  },
  "required": [
    "fields",
    "clauses"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "A service level objective: the promise made over an SLI.\n\n`clauses` is required because the objective is an invariant over the\nindicator, expressed as a clause; `objective` carries the same promise in\ntyped form once the extractor populates it. `operations` is forbidden by the\nseal, and so is every consumed-budget or sample key.",
  "allOf": [
    {
      "properties": {
        "fields": {
          "contains": {
            "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-operational/0.3.0/OccurrenceField.json"
          },
          "minContains": 0,
          "maxContains": 0
        }
      }
    }
  ]
}
