{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-operational/Deployment.json",
  "type": "object",
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.2/FieldDecl.json"
      },
      "minItems": 1,
      "contains": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-operational/IdentityField.json"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.2/OperationDecl.json"
      },
      "minItems": 1
    },
    "rollout": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-operational/RolloutDecl.json"
    },
    "deploys": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.2/SemanticId.json"
      }
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.2/SemanticId.json"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.2/RelationDecl.json"
      }
    },
    "clauses": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.2/ClauseRef.json"
      }
    }
  },
  "required": [
    "fields",
    "operations"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "A deployment: a released, running instance of a deployable and its lifecycle\noperations.\n\n`fields` carries the release identity, so at least one row is an identity\nfield; `operations` carries the lifecycle actions (deploy, roll back, scale)\nand has at least one item. `rollout` is the declared release strategy, never\nan executed rollout.",
  "allOf": [
    {
      "properties": {
        "fields": {
          "contains": {
            "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-operational/OccurrenceField.json"
          },
          "minContains": 0,
          "maxContains": 0
        }
      }
    }
  ]
}
